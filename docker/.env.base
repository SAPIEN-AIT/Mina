###
# General settings
###

# Isaac Lab base image
ISAACLAB_BASE_IMAGE=isaac-lab-base
# The Isaac Lab Extension Template path in the container
DOCKER_ISAACLAB_EXTENSION_TEMPLATE_PATH=/workspace/isaaclab_extension_template

# Run as host user inside container to avoid root-owned files on bind mounts.
# Override with: export LOCAL_UID=$(id -u) LOCAL_GID=$(id -g)
LOCAL_UID=1000
LOCAL_GID=1000

# Keep Docker virtualenv/cache isolated from host workspace state.
UV_PROJECT_ENVIRONMENT=/tmp/mina-uv-env
UV_CACHE_DIR=/tmp/mina-uv-cache
