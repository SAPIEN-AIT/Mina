# ignore .git related folders
.git/
.github/
.gitignore
# ignore docs
docs/
# ignore logs
**/logs/
**/runs/
**/output/*
**/outputs/*
**/videos/*
*.tmp
# ignore docker
docker/cluster/exports/
docker/.container.cfg
# ignore recordings
recordings/
# ignore __pycache__
**/__pycache__/
**/*.egg-info/
# ignore local python environments and caches
.venv/
**/.venv/
.cache/
**/.cache/
# ignore local ROS workspaces/build artifacts
ros_workspaces/
**/build/
**/install/
**/log/
# ignore isaac sim symlink
_isaac_sim?
