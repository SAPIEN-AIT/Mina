# ============================================================
# .env — shared environment for all Mina containers
# Copy this to docker/.env and fill in your values
# ============================================================

# ── NGC credentials (required to pull base images) ─────────
NGC_API_KEY=anN1Z3ZibTdvMnZpY29ncW9jZm4xOHJ2MTU6NWFjMjBmNDAtZTdiZS00YzA2LWFhZWItMzg0MjM2YjYzYTFj

# --- AppLauncher settings (required to pull base images) ───────

# ── Host paths ─────────────────────────────────────────────
# Absolute path to your Mina project root
MINA_ROOT=/home/alex/dev/Mina

# Absolute path to IsaacLab repo (for dev bind-mount)
ISAACLAB_ROOT=/home/alex/dev/IsaacLab

# ── Isaac Sim cache dirs (shared across all containers) ─────
# These persist between runs and avoid re-downloading assets
CACHE_KIT=${HOME}/docker/isaac-sim/cache/kit
CACHE_OV=${HOME}/docker/isaac-sim/cache/ov
CACHE_PIP=${HOME}/docker/isaac-sim/cache/pip
CACHE_GLCACHE=${HOME}/docker/isaac-sim/cache/glcache
CACHE_COMPUTECACHE=${HOME}/docker/isaac-sim/cache/computecache
LOGS_DIR=${HOME}/docker/isaac-sim/logs
DATA_DIR=${HOME}/docker/isaac-sim/data

# ── Training ────────────────────────────────────────────────
TASK=Velocity-Berkeley-Humanoid-Lite-Biped-v0
NUM_ENVS=4096

# ── Streaming ───────────────────────────────────────────────
# Set to your machine's public IP when streaming from cloud
PUBLIC_IP=127.0.0.1

# ── Versions ────────────────────────────────────────────────
ISAACLAB_VERSION=2.3.2
ISAACSIM_VERSION=4.5.0
