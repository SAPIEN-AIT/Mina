# ============================================================
# mina-bhl-training
# Purpose: headless RL training — bakes in berkeley_humanoid_lite
# Base: mina-isaaclab-base
# ============================================================
FROM mina-isaaclab-base:latest

# Copy source packages (packages already installed in base image via editable install)
COPY source/ /workspace/source/
    
# Copy training scripts
COPY scripts/ /workspace/scripts/
COPY configs/ /workspace/configs/

# Training env defaults
ENV HEADLESS=1
ENV ENABLE_CAMERAS=0

WORKDIR /workspace

CMD ["bash", "-c", \
     "isaaclab -p scripts/rsl_rl/train.py \
      --task ${TASK:-Velocity-Berkeley-Humanoid-Lite-Biped-v0} \
      --num_envs ${NUM_ENVS:-4096} \
      --headless"]
