# ============================================================
# mina-isaacsim-synthdata
# Purpose: synthetic dataset generation — pure Isaac Sim, no Lab RL stack
# Base: Isaac Sim 4.5.0 directly (leaner, no isaaclab overhead)
# ============================================================
FROM nvcr.io/nvidia/isaac-sim:4.5.0

ENV ACCEPT_EULA=Y
ENV PRIVACY_CONSENT=Y

# Offscreen rendering is required for camera-based data gen
ENV HEADLESS=1
ENV ENABLE_CAMERAS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Copy your data generation scripts
#COPY data_gen/ /workspace/data_gen/

WORKDIR /workspace

CMD ["bash", "-c", \
     "/isaac-sim/python.sh data_gen/generate.py \
      --scenes ${NUM_SCENES:-1000} \
      --output /output"]
